{
	"name": "proxy-development-server",
	"version": "1.0.0",
	"description": "",
	"private": "true",
	"type": "module",
	"scripts": {
		"test": "dotnet test",
		"lint": "pnpm run typecheck && pnpm run eslint:check && pnpm run prettier:check",
