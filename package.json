		"typecheck": "tsc -b"
	},
	"keywords": [],
	"author": "",
	"license": "MIT",
	"devDependencies": {
		"@darkpatternsdigital/eslint-config": "*",
		"@darkpatternsdigital/prettier-config": "*",
		"@darkpatternsdigital/tsconfigs": "*",
		"@eslint/compat": "^1.2.4",
		"@types/node": "^22.10.1",
		"eslint": "9.16.0",
		"prettier": "^3.4.2",
		"typescript": "^5.7.2"
	},
	"packageManager": "pnpm@9.10.0",
	"pnpm": {
		"peerDependencyRules": {
			"allowedVersions": {
				"eslint-plugin-import@2.29.1>eslint": ">=9"
			}
		}
	}
